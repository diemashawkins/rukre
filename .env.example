APP_NAME=RUKRE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- RUKRE: where your home server's media lives -----------------------------
# "local" = the media folder is on this machine (or mounted into it via NFS/SMB).
# "sftp"  = read the files over SSH from another machine on your network.
RUKRE_MEDIA_DRIVER=local
RUKRE_MEDIA_ROOT=/srv/media

# Folders inside RUKRE_MEDIA_ROOT (comma-separate several; leave empty to disable).
RUKRE_VIDEO_DIRS=Videos
RUKRE_AUDIO_DIRS=Music
RUKRE_BOOK_DIRS=Books

# Only needed when RUKRE_MEDIA_DRIVER=sftp
RUKRE_SFTP_HOST=
RUKRE_SFTP_PORT=22
RUKRE_SFTP_USERNAME=
RUKRE_SFTP_PASSWORD=
RUKRE_SFTP_PRIVATE_KEY=

# Sign-in is required by default. Create accounts with: php artisan rukre:user
RUKRE_REQUIRE_LOGIN=true

# How often the scheduler re-indexes (cron syntax). Needs `php artisan schedule:work` or a cron entry.
RUKRE_SCAN_SCHEDULE="0 * * * *"
